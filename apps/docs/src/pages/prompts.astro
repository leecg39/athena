---
import Doc from "../layouts/Doc.astro";

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<Doc locale={locale} title={tt("Setting Up Prompts | Athenum Docs")}>
  <h1>{tt("Setting Up Prompts")}</h1>
  <p>{tt("Build a useful prompt set with direct entry or the Discover tab. Group prompts into topics for aggregate reporting; attach personas and locations.")}</p>
  <h2>{tt("Schedules")}</h2>
  <p>{tt("The default schedule samples every active prompt daily. Custom schedules increase frequency for high-stakes prompts; archived schedules keep their history.")}</p>
</Doc>
