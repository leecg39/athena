---
import { APP_URL } from "../lib/app-url";
import Base from "../layouts/Base.astro";

const plans = [
  {
    name: "Free",
    price: "$0",
    credits: "300 monthly credits",
    models: "ChatGPT, Perplexity and Gemini",
    features: ["Up to 50 tracked prompts per website", "Olympus visibility & Share of Voice dashboard", "Sources & competitor heatmap analysis", "Ask Athena AI copilot", "3 prospect pitches / month"],
  },
  {
    name: "Starter",
    price: "$295",
    credits: "3,600 monthly credits",
    models: "Adds Claude, Grok and DeepSeek",
    popular: true,
    features: ["Up to 500 tracked prompts per website", "Knowledge Base & Oracle fact checks", "Content Hub publishing to WordPress, Webflow, Contentful, Sanity, Wix, Framer, Payload & Shopify", "Multi-scope credit pools (Org / Website / Group)", "10 prospect pitches / month + scheduled email & Slack reports"],
  },
  {
    name: "Enterprise",
    price: "$1,450",
    credits: "20,000 monthly credits",
    models: "All 6 AI models",
    features: ["Up to 5,000 tracked prompts per website", "Public REST API (/api/v1) & 14-tool MCP Server", "Looker Studio & Power BI connectors", "Custom roles, Google & Microsoft sign-in", "100 prospect pitches / month"],
  },
];

const addons = [
  { name: "REST API & MCP Server Add-on", price: "$99/mo", detail: "API keys with 60 requests/min, the 14-tool MCP server and Looker Studio & Power BI feeds (+500 credits with each paid month)." },
  { name: "Pitch Pro Add-on", price: "$75/mo", detail: "Extra pitch capacity for agencies (+500 credits with each paid month)." },
  { name: "Credit Packs", price: "$79 – $895", detail: "One-time packs: +1,000 for $79 · +5,000 for $345 · +15,000 for $895, added to the organization pool." },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<Base locale={locale} title={tt("Pricing | Athenum")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <div style="text-align:center;">
      <span class="badge">{tt("Transparent Credit Ledger · 1 Credit = 1 AI Response")}</span>
      <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:12px;">{tt("Plans & Credit Pricing")}</h1>
      <p style="color:#475569;margin-top:8px;font-size:16px;">{tt(" Save 20% with annual billing. Allocate credits flexibly across Organization, Website, and Agency Group pools. ")}</p>
    </div>

    <div class="grid-3" style="margin-top:40px;">
      {plans.map((p) => (
        <div class="card" style={p.popular ? "border-color:var(--brand);box-shadow:0 12px 40px rgba(79,57,246,0.12);" : ""}>
          {p.popular ? <span class="badge">{tt("Most Popular")}</span> : <span class="badge" style="background:#f1f5f9;color:#475569;">{tt("Tier")}</span>}
          <h2 style="font-size:22px;margin:12px 0 4px;">{tt(p.name)}</h2>
          <div style="font-size:38px;font-weight:800;">
            {tt(p.price)}<span style="font-size:14px;color:#64748b;font-weight:500;">{tt("/mo")}</span>
          </div>
          <div style="color:#475569;font-size:13px;font-weight:600;margin:6px 0 2px;">{tt(p.credits)}</div>
          <div style="color:#64748b;font-size:13px;margin-bottom:18px;">{tt(p.models)}</div>
          <ul style="list-style:none;padding:0;font-size:14px;color:#334155;display:grid;gap:10px;margin-bottom:24px;">
            {p.features.map((f) => <li>✓ {tt(f)}</li>)}
          </ul>
          <a class={`btn ${p.popular ? "btn-primary" : "btn-secondary"}`} style="width:100%;" href={`${APP_URL}/login`}>
            {tt(p.name === "Free" ? "Start Free Workspace" : "Sign in to upgrade")}
          </a>
        </div>
      ))}
    </div>

    <div style="margin-top:48px;">
      <h2 style="font-size:22px;margin-bottom:16px;">{tt("Add-ons & Credit Top-Up Packs")}</h2>
      <div class="grid-3">
        {addons.map((a) => (
          <div class="card" style="background:#f8fafc;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
              <strong style="font-size:15px;">{tt(a.name)}</strong>
              <span class="badge">{tt(a.price)}</span>
            </div>
            <p style="font-size:13px;color:#475569;">{tt(a.detail)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
