---
import Base from "../layouts/Base.astro";

const rows = [
  { capability: "Answers from 6 AI models (ChatGPT, Claude, Perplexity, Gemini, Grok, DeepSeek)", athenum: "Through each model's API, with your keys", trackers: "Varies by tool", seo: "Usually search results only" },
  { capability: "Fact checks against your Knowledge Base", athenum: "Oracle: answer, fact and model conflicts", trackers: "Varies by tool", seo: "Usually not included" },
  { capability: "Content Hub with publishing", athenum: "WordPress & Shopify; exports for other CMSs", trackers: "Varies by tool", seo: "Briefs only in many suites" },
  { capability: "Shopify product listing optimization", athenum: "Scores and updates listings via the Admin API", trackers: "Varies by tool", seo: "Varies by suite" },
  { capability: "Product cards and sponsored placements in answers", athenum: "Found in collected answers, plus manual records", trackers: "Varies by tool", seo: "Search ads data instead" },
  { capability: "AI crawler access & live content checks", athenum: "robots.txt for 10 AI bots, page hash verification", trackers: "Varies by tool", seo: "Usually search crawlers" },
  { capability: "Agency pitches & shared credit pools", athenum: "Measured prospect audits, group credit ledger", trackers: "Varies by tool", seo: "Varies by suite" },
  { capability: "REST API v1, 14-tool MCP server, Looker Studio / Power BI", athenum: "Included", trackers: "Varies by tool", seo: "Varies by suite" },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<Base locale={locale} title={tt("Compare Athenum | AI Search Intelligence vs. Legacy Tools")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <span class="badge">{tt("Platform Comparison")}</span>
    <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:14px;">{tt(" What Athenum Covers ")}</h1>
    <p style="color:#475569;margin-top:12px;max-width:680px;font-size:16px;">{tt(" A capability overview of Athenum next to typical prompt trackers and SEO suites. Other tools differ, so check their current features. ")}</p>
  </section>

  <section class="wrap" style="padding:16px 24px 48px;">
    <div style="overflow-x:auto;border:1px solid #e2e8f0;border-radius:16px;">
      <table style="width:100%;border-collapse:collapse;font-size:14px;text-align:left;">
        <thead>
          <tr style="background:#f8fafc;border-bottom:1px solid #e2e8f0;">
            <th style="padding:14px 18px;">{tt("Capability")}</th>
            <th style="padding:14px 18px;color:var(--brand);">{tt("Athenum Platform")}</th>
            <th style="padding:14px 18px;color:#64748b;">{tt("Basic Prompt Trackers")}</th>
            <th style="padding:14px 18px;color:#64748b;">{tt("Legacy SEO Suites")}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr style="border-bottom:1px solid #f1f5f9;">
              <td style="padding:14px 18px;font-weight:600;color:#0f172a;">{tt(r.capability)}</td>
              <td style="padding:14px 18px;font-weight:700;color:#059669;">✓ {tt(r.athenum)}</td>
              <td style="padding:14px 18px;color:#64748b;">{tt(r.trackers)}</td>
              <td style="padding:14px 18px;color:#64748b;">{tt(r.seo)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
