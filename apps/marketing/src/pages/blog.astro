---
import Base from "../layouts/Base.astro";

/** Topics for upcoming guides; no posts are published yet. */
const topics = [
  { category: "Getting started", title: "Choosing the buyer questions to track", excerpt: "How to turn your sales and support questions into prompts, topics and personas." },
  { category: "Engineering & MCP", title: "Connecting Claude and Looker Studio with the MCP server and REST API v1", excerpt: "Query share of voice, Knowledge Base facts and credit balances from Claude Desktop and BI dashboards." },
  { category: "Brand Safety", title: "Reviewing Oracle findings", excerpt: "What each finding type means and how to fix the source a model learned the wrong claim from." },
  { category: "Technical AEO", title: "AI crawler access: OAI-SearchBot, PerplexityBot and ClaudeBot", excerpt: "How robots.txt rules affect which AI crawlers can read your pages, and how Site Health checks them." },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
---
<Base locale={locale} title={tt("Blog | Athenum")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <span class="badge">{tt("Coming soon")}</span>
    <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:14px;">{tt("Guides we are writing")}</h1>
    <p style="color:#475569;margin-top:12px;max-width:660px;font-size:16px;">{tt("No posts are published yet. These are the first guides in progress; the product documentation covers the API, MCP server and features today.")}</p>
  </section>

  <section class="wrap grid-2" style="padding:16px 24px 48px;">
    {topics.map((t) => (
      <article class="card">
        <span class="badge" style="margin-bottom:10px;">{tt(t.category)}</span>
        <h2 style="font-size:20px;margin-bottom:10px;line-height:1.35;">{tt(t.title)}</h2>
        <p style="font-size:14px;color:#475569;line-height:1.6;">{tt(t.excerpt)}</p>
      </article>
    ))}
  </section>
</Base>
