---
import Base from "../layouts/Base.astro";
---
<Base title="Athenum | Agents to Win on AI Search">
  <section class="wrap" style="text-align:center;padding:80px 24px 60px;">
    <span class="badge">New — State of AI Search 2026 report</span>
    <h1 style="font-size:52px;letter-spacing:-2px;margin:20px 0 12px;line-height:1.05;">
      Become the Brand<br /><span style="color:var(--brand);">AI Trusts</span>
    </h1>
    <p style="font-size:18px;color:#6b7280;max-width:560px;margin:0 auto 28px;">
      See, act, and win on AI search. Athenum tracks your visibility across
      ChatGPT, Perplexity, Gemini and 8 more surfaces — then tells you exactly what to do next.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;">
      <a class="btn btn-primary" href="http://localhost:3000/signup">Get Free Audit (10m)</a>
      <a class="btn btn-secondary" href="/platform">Explore Platform →</a>
    </div>
  </section>

  <section class="wrap" style="padding:40px 24px;">
    <h2 style="text-align:center;font-size:14px;color:#9ca3af;text-transform:uppercase;letter-spacing:2px;">Trusted by 300+ brands</h2>
    <div style="display:flex;gap:36px;justify-content:center;flex-wrap:wrap;margin-top:20px;color:#c4c7d0;font-weight:700;">
      <span>Acme Co</span><span>Northwind</span><span>Globex</span><span>Initech</span><span>Umbrella</span><span>Hooli</span>
    </div>
  </section>

  <section class="wrap" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:40px 24px;">
    {[
      { h: "Monitor", p: "Track visibility, mentions, citations, sentiment and competitive movement across 11 AI surfaces." },
      { h: "Insights", p: "Trace every answer back to sources, claims and content gaps — with opportunity prioritization." },
      { h: "Action", p: "Turn opportunities into governed content, outreach and commerce workflows with Athena AI agents." },
    ].map((c) => (
      <div style="border:1px solid #eee;border-radius:16px;padding:24px;">
        <h3 style="font-size:18px;margin-bottom:8px;">{c.h}</h3>
        <p style="font-size:14px;color:#6b7280;line-height:1.6;">{c.p}</p>
      </div>
    ))}
  </section>
</Base>
