---
import Base from "../layouts/Base.astro";

const engines = [
  "ChatGPT Search",
  "Perplexity",
  "Claude",
  "Google AI Overviews",
  "Google AI Mode",
  "Gemini",
  "Microsoft Copilot",
  "Grok",
];

const pillars = [
  {
    badge: "01 · Olympus Visibility",
    title: "Monitor Mention Rate, Citation Share & AI Search Value",
    desc: "Measure how 8 answer engines rank and cite your brand across every buyer persona, region, and topic cluster.",
  },
  {
    badge: "02 · Oracle & Knowledge Base",
    title: "Eliminate Brand Hallucinations with Canonical Facts",
    desc: "Audit AI responses against your verified Knowledge Base pillars to detect inaccuracies, outdated pricing, and model drift.",
  },
  {
    badge: "03 · Content Hub, Outreach & MCP",
    title: "Deploy Citation-Engineered Content & Agency Pitches",
    desc: "Generate AEO briefs, full drafts, and Shopify catalog optimizations with 1-click publishing to Webflow, WordPress, Contentful, and Sanity.",
  },
];
---
<Base title="Athenum | AI Search Visibility & Answer Engine Optimization Platform">
  <section class="wrap" style="text-align:center;padding:84px 24px 56px;">
    <span class="badge">2026 Enterprise GEO & AEO Suite · Native MCP Server</span>
    <h1 style="font-size:52px;letter-spacing:-1.8px;margin:20px 0 16px;line-height:1.06;">
      Become the Default Answer<br /><span style="color:var(--brand);">Across Every AI Engine</span>
    </h1>
    <p style="font-size:18px;color:#475569;max-width:640px;margin:0 auto 32px;">
      Athenum tracks how ChatGPT, Perplexity, Claude, Gemini, and Google AI Overviews cite your brand—then deploys autonomous content, Oracle fact verification, and outreach workflows to win Share of Voice.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a class="btn btn-primary" href="http://localhost:3000/home">Launch Live Workspace</a>
      <a class="btn btn-secondary" href="/platform">Explore 8 Platform Modules →</a>
    </div>
  </section>

  <section class="wrap" style="padding:16px 24px 48px;">
    <p style="text-align:center;font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:1.5px;font-weight:600;">
      Continuous Multi-Model Collection Across 8 Answer Surfaces
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:16px;">
      {engines.map((engine) => (
        <span style="border:1px solid #e2e8f0;background:#f8fafc;border-radius:10px;padding:8px 14px;font-size:13px;font-weight:600;color:#334155;">
          {engine}
        </span>
      ))}
    </div>
  </section>

  <section class="wrap grid-3" style="padding:24px;">
    {pillars.map((c) => (
      <div class="card">
        <span class="badge" style="margin-bottom:12px;">{c.badge}</span>
        <h2 style="font-size:19px;margin-bottom:8px;">{c.title}</h2>
        <p style="font-size:14px;color:#475569;line-height:1.6;">{c.desc}</p>
      </div>
    ))}
  </section>

  <section class="wrap" style="padding:48px 24px 16px;">
    <div class="card" style="background:#0f172a;color:#fff;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;padding:36px;">
      <div>
        <span class="badge" style="background:rgba(79,57,246,0.25);color:#c7d2fe;">Agency Pitch Workspace & Multi-Brand Groups</span>
        <h2 style="font-size:24px;margin-top:10px;">Run 60-Second Prospect Audits & Shared Credit Pools</h2>
        <p style="color:#94a3b8;font-size:14px;margin-top:6px;max-width:600px;">
          Generate shareable prospect visibility benchmarks and Before/After AEO content rewrite pitches with FAQPage JSON-LD schema.
        </p>
      </div>
      <a class="btn btn-primary" href="/case-studies">Read Customer Case Studies →</a>
    </div>
  </section>
</Base>
