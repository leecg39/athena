---
import Base from "../layouts/Base.astro";

const modules = [
  {
    name: "Olympus Dashboard",
    tag: "Visibility & SOV",
    summary: "Track Mention Rate, Citation Rate, Share of Voice, Average Ranking Position, and Estimated AI Search Traffic Value with saved views and CSV export.",
  },
  {
    name: "Responses & Sources Intelligence",
    tag: "Citation Graph",
    summary: "Inspect every full AI response matrix, Sankey domain flows, C/T/O/P source classification, and standalone URL citation inspector.",
  },
  {
    name: "Ask Athena Copilot",
    tag: "Agentic Chat",
    summary: "Query live workspace metrics, search collected LLM answers, and generate content briefs with file attachments and Google Search Console context.",
  },
  {
    name: "Knowledge Base & Oracle",
    tag: "Brand Truth",
    summary: "Maintain canonical brand pillars and facts while Oracle scans LLM outputs for Confirmed Inaccuracies, KB Discrepancies, and Model Divergence.",
  },
  {
    name: "Content Hub & Shopify Catalog Optimization",
    tag: "Execution",
    summary: "Spreadsheet grid with AI Brief → Draft → Revise with Athena versioning and 1-click CMS publishing (WordPress, Webflow, Contentful, Sanity, Wix, Framer, Payload).",
  },
  {
    name: "Outreach & Citation Pipeline",
    tag: "Authority",
    summary: "Discover high-citation third-party pages, resolve author contacts, draft KB-grounded outreach emails, and manage status in a New/Todo/Done Kanban.",
  },
  {
    name: "Shopping Insights, Sponsored Ads & Site Health",
    tag: "Commerce & Technical AEO",
    summary: "Monitor AI shopping carousels, ChatGPT/AI Mode sponsored ad captures, 10 AI crawler access checks (OAI-SearchBot, PerplexityBot, ClaudeBot), and live page verification.",
  },
  {
    name: "Public REST API v1, MCP Server & BI Connectors",
    tag: "Ecosystem",
    summary: "Connect Claude/ChatGPT via @athena/mcp (14 tools) or stream daily visibility datasets directly into Google Looker Studio and Microsoft Power BI.",
  },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<Base locale={locale} title={tt("Platform | Athenum AI Search Intelligence")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <span class="badge">{tt("End-to-End AEO Architecture")}</span>
    <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:14px;">{tt(" Eight Integrated Modules Built for AI Search Dominance ")}</h1>
    <p style="color:#475569;margin-top:12px;max-width:680px;font-size:16px;">{tt(" Unlike legacy keyword rank trackers, Athenum combines multi-model prompt collection, citation graph analytics, hallucination detection, and direct CMS publishing in one governed workspace. ")}</p>
  </section>

  <section class="wrap grid-2" style="padding:16px 24px 48px;">
    {modules.map((m) => (
      <div class="card">
        <span class="badge">{tt(m.tag)}</span>
        <h2 style="font-size:20px;margin:12px 0 8px;">{tt(m.name)}</h2>
        <p style="font-size:14px;color:#475569;line-height:1.65;">{tt(m.summary)}</p>
      </div>
    ))}
  </section>
</Base>
