---
import Base from "../layouts/Base.astro";

const modules = [
  { name: "Olympus Dashboard", tag: "Visibility & SOV", summary: "Mention rate, citation rate, share of voice and average position from collected answers, with saved views, filters, CSV export and AI-visible searches when search volume is available." },
  { name: "Responses & Sources Intelligence", tag: "Citation Graph", summary: "Every collected answer with its mentions and citations, a Sankey view of cited domains, domain classification and a standalone URL inspector." },
  { name: "Ask Athena Copilot", tag: "Agentic Chat", summary: "Ask questions about your workspace metrics and collected answers, attach files, and use Search Console data when it is connected." },
  { name: "Knowledge Base & Oracle", tag: "Brand Truth", summary: "Approved brand facts in pillars; Oracle flags answers that conflict with them, facts that conflict with each other, and prompts where models disagree." },
  { name: "Content Hub & Shopify Catalog Optimization", tag: "Execution", summary: "Briefs, drafts and versions grounded in confirmed facts; direct publishing to WordPress, Webflow, Contentful, Sanity, Wix, Framer, Payload and Shopify; Shopify listing scores and updates." },
  { name: "Outreach & Citation Pipeline", tag: "Authority", summary: "Third-party pages that AI answers cite about your topics, authors read from the pages themselves, pitch drafts from verified facts and a New/Todo/Done board." },
  { name: "Shopping Insights, Sponsored Ads & Site Health", tag: "Commerce & Technical AEO", summary: "Product cards and sponsored placements found in collected answers, robots.txt checks for 10 AI crawlers, sitemap and llms.txt checks, and live page verification." },
  { name: "Public REST API v1, MCP Server & BI Connectors", tag: "Ecosystem", summary: "Connect Claude or ChatGPT through the MCP server (14 tools), call /api/v1 with API keys, or feed Looker Studio and Power BI." },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<Base locale={locale} title={tt("Platform | Athenum AI Search Intelligence")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <span class="badge">{tt("End-to-End AEO Architecture")}</span>
    <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:14px;">{tt(" Eight Modules for AI Search Visibility ")}</h1>
    <p style="color:#475569;margin-top:12px;max-width:680px;font-size:16px;">{tt(" Athenum combines multi-model answer collection, citation analytics, fact checking against your Knowledge Base, and content publishing in one workspace. ")}</p>
  </section>

  <section class="wrap grid-2" style="padding:16px 24px 48px;">
    {modules.map((m) => (
      <div class="card">
        <span class="badge">{tt(m.tag)}</span>
        <h2 style="font-size:20px;margin:12px 0 8px;">{tt(m.name)}</h2>
        <p style="font-size:14px;color:#475569;line-height:1.65;">{tt(m.summary)}</p>
      </div>
    ))}
  </section>
</Base>
