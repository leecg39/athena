---
import Base from "../layouts/Base.astro";

/** Illustrative workflows built from the product's real features (no customer results). */
const workflows = [
  {
    team: "B2B SaaS marketing team",
    industry: "B2B SaaS",
    headline: "Find the comparison questions where AI answers recommend competitors",
    steps: ["Track 30–50 buyer questions per topic", "Read which pages the answers cite", "Draft a comparison guide from confirmed facts and publish it to WordPress"],
  },
  {
    team: "Shopify store",
    industry: "E-Commerce & Retail",
    headline: "Improve product listings and watch product cards in AI answers",
    steps: ["Sync products from Shopify", "Fix the listings with the lowest title and description scores", "Compare product cards in collected answers before and after"],
  },
  {
    team: "SEO / AEO agency",
    industry: "Digital & AEO Agency",
    headline: "Pitch a prospect with measured AI-answer visibility",
    steps: ["Ask the AI models five of the prospect's buyer questions", "Share the measured pitch link", "Add a rewrite of the prospect's own page copy"],
  },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
---
<Base locale={locale} title={tt("Example Workflows | Athenum")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <span class="badge">{tt("Example workflows (illustrative, not customer results)")}</span>
    <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:14px;">{tt("How Teams Use Athenum")}</h1>
    <p style="color:#475569;margin-top:12px;max-width:660px;font-size:16px;">{tt("Typical ways SaaS, commerce and agency teams use the product. Results depend on your market and content.")}</p>
  </section>

  <section class="wrap" style="padding:16px 24px 48px;display:grid;gap:24px;">
    {workflows.map((w) => (
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
          <span class="badge">{tt(w.industry)}</span>
          <strong style="font-size:14px;color:#475569;">{tt(w.team)}</strong>
        </div>
        <h2 style="font-size:24px;margin:12px 0 10px;">{tt(w.headline)}</h2>
        <ol style="font-size:14px;color:#334155;line-height:1.65;padding-left:18px;">
          {w.steps.map((s) => <li>{tt(s)}</li>)}
        </ol>
      </div>
    ))}
  </section>
</Base>
