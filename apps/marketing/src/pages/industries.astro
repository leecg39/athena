---
import Base from "../layouts/Base.astro";

const verticals = [
  {
    sector: "B2B SaaS & Developer Tools",
    kpi: "+44% Buyer Shortlist Mentions",
    challenge: "Enterprise buyers ask ChatGPT and Claude 'What is the best SOC2-compliant vector design tool?' instead of clicking 10 blue links.",
    solution: "Athenum tracks high-intent comparison prompts, maps third-party review citations (G2, TrustRadius, GitHub), and ships technical comparison guides straight to Webflow or Sanity.",
  },
  {
    sector: "E-Commerce, D2C & Retail Brands",
    kpi: "3.2x AI Shopping Carousel Placements",
    challenge: "ChatGPT Shopping, Perplexity Buy, and Google AI Mode recommend products based on structured schema and merchant authority.",
    solution: "Our Shopping Insights and Shopify Catalog Optimization engine rewrites product descriptions with structured JSON-LD attributes and monitors retailer distribution.",
  },
  {
    sector: "Digital, SEO & Performance Agencies",
    kpi: "14+ New AEO Retainers Closed / Quarter",
    challenge: "Agencies need a repeatable way to pitch AI Search Optimization to prospects and manage multi-brand credit budgets.",
    solution: "Pitch Workspace generates 60-second prospect visibility audits and Before/After AEO content rewrite proposals, while Group Dashboards pool shared credits across client portfolios.",
  },
  {
    sector: "FinTech, Security & Regulated Enterprises",
    kpi: "99.4% Brand Claim Accuracy via Oracle",
    challenge: "Hallucinated interest rates, compliance certifications, or outdated SLA terms in LLM outputs create legal and reputational risk.",
    solution: "Oracle continuously cross-checks AI responses against your approved Knowledge Base facts and flags Confirmed Inaccuracies for immediate remediation.",
  },
];

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<Base locale={locale} title={tt("Industries | Athenum AI Search Solutions")}>
  <section class="wrap" style="padding:64px 24px 32px;">
    <span class="badge">{tt("Industry Playbooks")}</span>
    <h1 style="font-size:42px;letter-spacing:-1.2px;margin-top:14px;">{tt(" Tailored AI Visibility Workflows for Every Sector ")}</h1>
    <p style="color:#475569;margin-top:12px;max-width:660px;font-size:16px;">{tt(" From high-growth SaaS and Shopify merchants to multi-client agencies and regulated financial institutions, Athenum adapts to your vertical's citation landscape. ")}</p>
  </section>

  <section class="wrap grid-2" style="padding:16px 24px 48px;">
    {verticals.map((v) => (
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <span class="badge">{tt(v.sector)}</span>
          <strong style="font-size:13px;color:#059669;">{tt(v.kpi)}</strong>
        </div>
        <h2 style="font-size:19px;margin:14px 0 8px;">{tt(v.sector)}</h2>
        <p style="font-size:13px;color:#64748b;margin-bottom:10px;">
          <strong>{tt("Challenge:")}</strong> {tt(v.challenge)}
        </p>
        <p style="font-size:14px;color:#334155;line-height:1.6;">
          <strong>{tt("Athenum Solution:")}</strong> {tt(v.solution)}
        </p>
      </div>
    ))}
  </section>
</Base>
