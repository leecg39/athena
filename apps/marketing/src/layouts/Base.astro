---
import { APP_URL } from "../lib/app-url";
import LanguageSwitch from "../components/LanguageSwitch.astro";
interface Props {
  locale?: "ko" | "en";
  title: string;
  description?: string;
}
const {
  title,
  description = "Athenum — AI Search Visibility, Answer Engine Optimization & Autonomous Content Platform.",
} = Astro.props;

import { createTranslator, resolveLocale } from "@athena/i18n";
const locale = resolveLocale(Astro.props.locale);
const tt = createTranslator(locale);
const hrefFor = (url: string) => locale === "en" && url.startsWith("/") && !url.startsWith("//") ? `/en${url === "/" ? "" : url}` : url;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tt(title)}</title>
    <meta name="description" content={tt(description)} />
    <style is:global>
      html[lang="ko"] body { word-break:keep-all; overflow-wrap:anywhere; }
      :root {
        --brand: #4f39f6;
        --brand-dark: #3b27d1;
        --brand-light: #eef2ff;
        --slate-900: #0f172a;
        --slate-600: #475569;
        --slate-200: #e2e8f0;
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--slate-900);
        background: #ffffff;
        line-height: 1.5;
      }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-primary:hover { background: var(--brand-dark); }
      .btn-secondary { border: 1px solid var(--slate-200); color: #1e293b; background: #fff; }
      .btn-secondary:hover { background: #f8fafc; }
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: var(--brand-light);
        color: var(--brand);
      }
      .card {
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        padding: 24px;
        background: #fff;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
      }
      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
        gap: 24px;
      }
    </style>
  </head>
  <body>
    <header style="border-bottom:1px solid #f1f5f9;position:sticky;top:0;background:rgba(255,255,255,0.92);backdrop-filter:blur(8px);z-index:20;">
      <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;padding:16px 24px;flex-wrap:wrap;gap:12px;">
        <a href={hrefFor("/")} style="display:flex;align-items:center;gap:10px;text-decoration:none;color:#0f172a;font-weight:700;font-size:18px;">
          <span style="display:inline-flex;width:32px;height:32px;border-radius:9px;background:var(--brand);color:#fff;align-items:center;justify-content:center;">◈</span>{tt(" Athenum ")}</a>
        <nav aria-label={tt("Main navigation")} style="display:flex;gap:20px;font-size:14px;font-weight:500;flex-wrap:wrap;">
          <a href={hrefFor("/platform")} style="color:#475569;text-decoration:none;">{tt("Platform")}</a>
          <a href={hrefFor("/pricing")} style="color:#475569;text-decoration:none;">{tt("Pricing")}</a>
          <a href={hrefFor("/industries")} style="color:#475569;text-decoration:none;">{tt("Industries")}</a>
          <a href={hrefFor("/comparison")} style="color:#475569;text-decoration:none;">{tt("Compare")}</a>
          <a href={hrefFor("/case-studies")} style="color:#475569;text-decoration:none;">{tt("Example Workflows")}</a>
          <a href={hrefFor("/blog")} style="color:#475569;text-decoration:none;">{tt("Blog")}</a>
        </nav>
        <div style="display:flex;gap:10px;align-items:center;">
          <LanguageSwitch locale={locale} />
          <a class="btn btn-secondary" href={`${APP_URL}/login`}>{tt("Sign in")}</a>
          <a class="btn btn-primary" href={`${APP_URL}/home`}>{tt("Launch Workspace →")}</a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer style="border-top:1px solid #f1f5f9;margin-top:80px;background:#f8fafc;padding:48px 0;">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;font-size:13px;color:#64748b;">
        <div>
          <strong style="color:#0f172a;">{tt("Athenum AI Search Intelligence")}</strong>{tt(" — AI search visibility, fact checking and content workflows. ")}</div>
        <div style="display:flex;gap:16px;">
          <a href={hrefFor("/platform")} style="color:#64748b;text-decoration:none;">{tt("Platform")}</a>
          <a href={hrefFor("/pricing")} style="color:#64748b;text-decoration:none;">{tt("Pricing")}</a>
          <a href={hrefFor("/industries")} style="color:#64748b;text-decoration:none;">{tt("Industries")}</a>
          <a href={hrefFor("/comparison")} style="color:#64748b;text-decoration:none;">{tt("Comparison")}</a>
          <a href={hrefFor("/case-studies")} style="color:#64748b;text-decoration:none;">{tt("Example Workflows")}</a>
          <a href={hrefFor("/blog")} style="color:#64748b;text-decoration:none;">{tt("Blog")}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
