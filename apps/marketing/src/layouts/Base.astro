---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Track, understand and act on your AI search presence." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root { --brand: #4f39f6; --brand-light: #7c86ff; }
      * { box-sizing: border-box; margin: 0; }
      body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #111; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      .btn { display: inline-flex; padding: 10px 20px; border-radius: 10px; font-size: 14px; text-decoration: none; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-secondary { border: 1px solid #e5e7eb; color: #374151; }
      .badge { display: inline-flex; padding: 4px 10px; border-radius: 999px; font-size: 12px; background: #f4f3ff; color: var(--brand); }
    </style>
  </head>
  <body>
    <header class="wrap" style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px;">
      <a href="/" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:#111;font-weight:600;">
        <span style="display:inline-flex;width:30px;height:30px;border-radius:8px;background:var(--brand);color:#fff;align-items:center;justify-content:center;">◈</span>
        Athenum
      </a>
      <nav style="display:flex;gap:20px;font-size:14px;">
        <a href="/platform" style="color:#4b5563;text-decoration:none;">Platform</a>
        <a href="/pricing" style="color:#4b5563;text-decoration:none;">Pricing</a>
        <a href="/case-studies" style="color:#4b5563;text-decoration:none;">Case Studies</a>
        <a href="/blog" style="color:#4b5563;text-decoration:none;">Blog</a>
        <a href="/comparison" style="color:#4b5563;text-decoration:none;">Compare</a>
      </nav>
      <div style="display:flex;gap:10px;">
        <a class="btn btn-secondary" href="http://localhost:3000/login">Log in</a>
        <a class="btn btn-primary" href="http://localhost:3000/signup">Start free</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="wrap" style="border-top:1px solid #eee;margin-top:60px;padding:28px 24px;font-size:13px;color:#9ca3af;">
      © 2026 Athenum — observation-based reimagination for internal use. Not affiliated with any other product.
    </footer>
  </body>
</html>
