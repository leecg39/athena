{
  "name": "athena-clone",
  "private": true,
  "version": "0.1.0",
  "description": "AEO/GEO platform clone of AthenaHQ (app.athenahq.ai) - observation-based reimplementation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @athena/db",
    "db:migrate": "npm run migrate -w @athena/db",
    "db:push": "npm run push -w @athena/db",
    "db:seed": "npm run seed -w @athena/jobs",
    "test": "vitest run"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8"
}
