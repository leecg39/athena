# ---- Core ----
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Encrypts stored integration credentials (CMS tokens, Slack webhooks, Search Console); falls back to AUTH_SECRET
INTEGRATIONS_SECRET=""
# Local only: passwordless developer login (ignored when NODE_ENV=production)
AUTH_DEV_LOGIN="false"
# Local only: answers from a clearly labelled simulator when no LLM key is set (ignored in production)
LLM_SIMULATED_PROVIDER="false"

# ---- OAuth (Auth.js) — Google is also used for Search Console ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ---- Email (Resend): magic links, invites and scheduled reports. EMAIL_FROM must be a verified sender ----
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- LLM providers (answer collection, writing). Only providers with a key are used ----
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
PERPLEXITY_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""

# ---- Billing (Stripe). Without both keys, purchases are disabled ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ids per item (Checkout uses them; renewals and portal changes are matched by them)
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_ANNUAL=""
STRIPE_PRICE_PACK_1K=""
STRIPE_PRICE_PACK_5K=""
STRIPE_PRICE_PACK_15K=""
STRIPE_PRICE_ADDON_API_MCP=""
STRIPE_PRICE_ADDON_PITCH_PRO=""
# Development only: apply plan/pack/add-on changes without payment, recorded as "test — not charged".
# Ignored when NODE_ENV=production. Never enable in a shared or production environment.
BILLING_TEST_MODE="false"

# ---- Analytics / Observability ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Bearer token required by POST /api/otel/traces (ingestion is disabled when empty)
OTEL_INGEST_TOKEN=""

# ---- Background jobs (Inngest). Without it, Vercel Cron (/api/cron/dispatch) dispatches schedules ----
INNGEST_EVENT_KEY=""
CRON_SECRET="secret-for-vercel-cron-endpoints"

# ---- App URLs ----
# Used for links in report emails and Slack posts (required in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Marketing site (apps/marketing): where "Sign in" / "Launch workspace" link to
PUBLIC_APP_URL="http://localhost:3000"

# ---- MCP server (apps/mcp) ----
ATHENUM_API_KEY=""
ATHENUM_API_URL="http://localhost:3000"
